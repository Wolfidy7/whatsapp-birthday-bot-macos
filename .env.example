# Données de démonstration. Copier vers .env, puis adapter à votre groupe.
# Les intervalles sont en secondes. SEND_TIME utilise le fuseau TIMEZONE.
TIMEZONE="UTC"
WHATSAPP_GROUP="Groupe Démo"
SEND_TIME="09:00"
MESSAGE_HEADER="Assistant anniversaires"
MESSAGE_TEMPLATE="Bon anniversaire {name} !"
MAX_MESSAGES_PER_RUN=2
SCHEDULER_INTERVAL_SECONDS=300
ONE_OFF_INTERVAL_SECONDS=15
TEST_MESSAGE="Message de démonstration"
ONE_OFF_MESSAGE="Rappel de démonstration"
